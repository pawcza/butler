# ──────────────────────────────────────────────────────────
# butler-core — Unraid Docker deployment env
# Copy to .env and fill in real IPs and your HA token
# ──────────────────────────────────────────────────────────

# Home Assistant — RPi, accessed by LAN IP
HA_URL=http://localhost:8123
HA_TOKEN=your_long_lived_token_here

# Ollama — home server PC, accessed by LAN IP
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b

# Hermes agent — does the LLM work, tools and Home Assistant
HERMES_API_URL=http://hermes-agent:8642/v1
HERMES_API_KEY=your_hermes_api_server_key

# conversation-api — keeps the conversation threads (butler's key from LLM_PROXY_KEYS)
PERSONA_API_URL=http://conversation-api:3001/v1
PERSONA_API_KEY=your_butler_key

# STT — Whisper service on proxynet (model configured in Docker container)
WHISPER_URL=http://Speaches:8000

# TTS — Speaches on proxynet (use Docker hostname + container port)
PIPER_URL=http://Speaches:8000
PIPER_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
PIPER_VOICE=af_heart
PIPER_RESPONSE_FORMAT=mp3

# Basic auth (optional — omit both to disable)
AUTH_USER=butler
AUTH_PASS=changeme

# Butler server port
PORT=3000
