# Copy to .env and fill in. Only LLM_MODEL is required.
# Every base URL includes the /v1 part, the way OpenAI-compatible clients expect it.

# Language model: any server with a streaming /chat/completions endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Local servers usually need no key
LLM_API_KEY=
# Optional. Voice replies work best short and free of markdown. Leave empty to send no system message,
# for servers that bring their own prompt.
LLM_SYSTEM_PROMPT=You are Butler, a voice assistant. Answer in a few short spoken sentences. Never use markdown.
# Optional. Sent as metadata.locale (e.g. pl or en), only when set, for servers that localise their replies.
LLM_LOCALE=
# Optional. Sent as the OpenAI "user" field when nobody is signed in. With login on, the user's OIDC
# subject id is sent instead (an opaque id, never a name or email).
LLM_USER=
# Optional. 1 asks a persona server for its named stream events (x-persona-events: 1), so the tools it
# runs itself show as they run. Leave empty for any other server.
LLM_PERSONA_EVENTS=
LLM_MAX_TOOL_ITERATIONS=8

# Speech to text: POST /audio/transcriptions. Empty means typed chat only.
# Speaches on its default port would be http://localhost:8000/v1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Text to speech: POST /audio/speech. Empty means silent replies.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
TTS_RESPONSE_FORMAT=mp3
# Optional voice per reply language (only "pl" is detected so far); other replies use TTS_MODEL and TTS_VOICE.
# TTS_VOICES={"pl":{"model":"speaches-ai/piper-pl_PL-gosia-medium","voice":"gosia"}}
# 1 synthesizes one throwaway word when a turn starts, so an engine that unloads its model between uses
# has it loaded by the first sentence. Costs one tiny synthesis per turn, skipped when one finished in the
# last 30 seconds. Leave 0 for hosted engines.
TTS_WARMUP=0

# Optional tools: inline JSON or a path to a JSON file. See the MCP section of the README.
MCP_SERVERS=

# Where conversation threads are stored
DATA_DIR=./data

# Hands-free activation word
WAKE_WORD=butler

# Optional login through any OpenID Connect provider (built for Authentik). Leave OIDC_ISSUER empty
# for no login at all. With it set, every OIDC_* value and SESSION_SECRET is required.
# The issuer is the provider's issuer URL, e.g. https://authentik.example.com/application/o/butler/
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Where the provider sends you back: https://<your host>/auth/callback. Its origin is also the app's public origin.
OIDC_REDIRECT_URI=
# Comma-separated group names allowed in. Empty means any user the provider signs in.
OIDC_ALLOWED_GROUPS=
# Signs the session cookie, 32+ characters: openssl rand -base64 48
SESSION_SECRET=
