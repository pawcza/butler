# Copy to .env and fill in. Only LLM_MODEL is required.
# Every base URL includes the /v1 part, the way OpenAI-compatible clients expect it.

# Language model: any server with a streaming /chat/completions endpoint
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b
# Local servers usually need no key
LLM_API_KEY=
# Optional. Voice replies work best short and free of markdown.
LLM_SYSTEM_PROMPT=You are Butler, a voice assistant. Answer in a few short spoken sentences. Never use markdown.
LLM_MAX_TOOL_ITERATIONS=8

# Speech to text: POST /audio/transcriptions. Empty means typed chat only.
# Speaches on its default port would be http://localhost:8000/v1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# Text to speech: POST /audio/speech. Empty means silent replies.
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
TTS_VOICE=af_heart
TTS_RESPONSE_FORMAT=mp3

# Optional tools: inline JSON or a path to a JSON file. See the MCP section of the README.
MCP_SERVERS=

# Where conversation threads are stored
DATA_DIR=./data

# Hands-free activation word
WAKE_WORD=butler

# Optional HTTP basic auth. Set both when butler is reachable by anyone but you.
AUTH_USER=
AUTH_PASS=
