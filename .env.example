# ──────────────────────────────────────────────────────────
# butler-core — local PC development env
# Copy to .env and fill in your values
# ──────────────────────────────────────────────────────────

# Home Assistant (RPi on LAN)
HA_URL=http://localhost:8123
HA_TOKEN=your_long_lived_token_here

# Ollama (home server PC on LAN) — LLM inference
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# STT — Whisper service (port 9090, model configured in Docker container)
WHISPER_URL=http://localhost:9090

# TTS — Speaches (port 8090, /v1/audio/speech)
PIPER_URL=http://localhost:8090
PIPER_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
PIPER_VOICE=af_heart
PIPER_RESPONSE_FORMAT=mp3

# Butler server port
PORT=3000
